            "url": { "raw": "{{baseUrl}}/api/user/checkout", "host": ["{{baseUrl}}"], "path": ["api", "user", "checkout"] },
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": \"{{addressId}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
