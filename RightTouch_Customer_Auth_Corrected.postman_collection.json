            "description": "scheduledAt must be tomorrow/day-after-tomorrow (business timezone).",
            "body": { "mode": "raw", "raw": "{\n  \"addressId\": \"{{addressId}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
