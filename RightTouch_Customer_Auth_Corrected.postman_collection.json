{
  "info": {
    "name": "RightTouch API - Customer (Passwordless, Corrected)",
    "description": "Customer suite per Customer Flow doc. Passwordless mobile-OTP ONLY — no passwords anywhere. Live baseUrl default. Envelope: success { success:true, message, result }, failure { success:false, message, code?, result? }. identifier and mobileNumber are interchangeable (10 digits, optional +91). Verify-OTP test scripts save {{customerToken}} + {{refreshToken}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://righttouch-backend-fn9z.onrender.com", "type": "string" },
    { "key": "customerToken", "value": "PASTE_OR_RUN_VERIFY_OTP", "type": "string" },
    { "key": "refreshToken", "value": "PASTE_OR_RUN_VERIFY_OTP", "type": "string" },
    { "key": "mobile", "value": "9876543210", "type": "string" },
    { "key": "otp", "value": "123456", "type": "string" },
    { "key": "addressId", "value": "REPLACE_WITH_ADDRESS_ID", "type": "string" },
    { "key": "serviceId", "value": "REPLACE_WITH_SERVICE_ID", "type": "string" },
    { "key": "categoryId", "value": "REPLACE_WITH_CATEGORY_ID", "type": "string" },
    { "key": "bookingId", "value": "REPLACE_WITH_BOOKING_ID", "type": "string" },
    { "key": "quotationId", "value": "REPLACE_WITH_QUOTATION_ID", "type": "string" },
    { "key": "quoteRequestId", "value": "REPLACE_WITH_QUOTE_REQUEST_ID", "type": "string" }
  ],
  "item": [
    {
      "name": "Stage 0 - Signup + Login (OTP only)",
      "item": [
        {
          "name": "1 Signup - request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/signup/customer", "host": ["{{baseUrl}}"], "path": ["api", "user", "signup", "customer"] },
            "description": "New number. Duplicate registered number -> 409 MOBILE_ALREADY_EXISTS (use Login instead).",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mobileNumber\": \"{{mobile}}\",\n  \"termsAndServices\": true,\n  \"privacyPolicy\": true\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "2 Signup - verify OTP (201, saves tokens)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/signup/customer/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "user", "signup", "customer", "verify-otp"] },
            "description": "201 Account created successfully. result: { token, refresh_token, expires_in, user, technicianProfileId: null }.",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mobileNumber\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const b = pm.response.json();", "if (b?.result?.token) pm.collectionVariables.set('customerToken', b.result.token);", "if (b?.result?.refresh_token) pm.collectionVariables.set('refreshToken', b.result.refresh_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "3 Login - request OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/login/customer", "host": ["{{baseUrl}}"], "path": ["api", "user", "login", "customer"] },
            "description": "Registered number. 200 OTP sent successfully (purpose: LOGIN).",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mobileNumber\": \"{{mobile}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "4 Login - verify OTP (saves tokens)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/login/customer/verify-otp", "host": ["{{baseUrl}}"], "path": ["api", "user", "login", "customer", "verify-otp"] },
            "description": "200/201 Login successful. Same result shape as signup verify.",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mobileNumber\": \"{{mobile}}\",\n  \"otp\": \"{{otp}}\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const b = pm.response.json();", "if (b?.result?.token) pm.collectionVariables.set('customerToken', b.result.token);", "if (b?.result?.refresh_token) pm.collectionVariables.set('refreshToken', b.result.refresh_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Resend OTP (60s cooldown -> 429 OTP_COOLDOWN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/resend-otp", "host": ["{{baseUrl}}"], "path": ["api", "user", "resend-otp"] },
            "description": "Wrong OTP -> 400 OTP_INVALID (5 attempts then 429). Expired/reused -> 400 OTP_INVALID_OR_EXPIRED.",
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"{{mobile}}\",\n  \"mobileNumber\": \"{{mobile}}\"\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Stage 0b - Sessions",
      "item": [
        {
          "name": "Refresh (rotation, saves new tokens)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "user", "auth", "refresh"] },
            "description": "Old refresh dies immediately; replay -> 401 + whole family revoked. Missing/malformed -> 400; bad/expired/revoked -> 401 REFRESH_INVALID.",
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}", "options": { "raw": { "language": "json" } } }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const b = pm.response.json();", "if (b?.result?.token) pm.collectionVariables.set('customerToken', b.result.token);", "if (b?.result?.refresh_token) pm.collectionVariables.set('refreshToken', b.result.refresh_token);"], "type": "text/javascript" } }]
        },
        {
          "name": "Logout (one device)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "user", "auth", "logout"] },
            "description": "Current session dies now; other devices unaffected. Socket gets session:revoked."
          }
        },
        {
          "name": "Logout all devices",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/auth/logout-all", "host": ["{{baseUrl}}"], "path": ["api", "user", "auth", "logout-all"] },
            "description": "All sessions revoked, global token version bumped, all sockets disconnected."
          }
        }
      ]
    },
    {
      "name": "Stage 1 - Profile",
      "item": [
        {
          "name": "GET me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/me", "host": ["{{baseUrl}}"], "path": ["api", "user", "me"] }
          }
        },
        {
          "name": "POST complete-profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/complete-profile", "host": ["{{baseUrl}}"], "path": ["api", "user", "complete-profile"] },
            "body": { "mode": "raw", "raw": "{\n  \"fname\": \"John\",\n  \"lname\": \"Doe\",\n  \"gender\": \"male\",\n  \"email\": \"john@example.com\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "PUT me (update profile)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/me", "host": ["{{baseUrl}}"], "path": ["api", "user", "me"] },
            "description": "Only fname, lname, gender, email are honored.",
            "body": { "mode": "raw", "raw": "{\n  \"fname\": \"John\",\n  \"lname\": \"Doe\"\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "POST accept-terms",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/auth/accept-terms", "host": ["{{baseUrl}}"], "path": ["api", "user", "auth", "accept-terms"] },
            "body": { "mode": "raw", "raw": "{\n  \"termsAndServices\": true,\n  \"privacyPolicy\": true\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "DELETE delete-my-account",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/user/delete-my-account", "host": ["{{baseUrl}}"], "path": ["api", "user", "delete-my-account"] },
            "description": "All sessions revoked; refresh can never restore access."
          }
        }
      ]
    },
    {
      "name": "Stage 2 - Addresses + Zones",
      "item": [
        {
          "name": "POST create address",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/addresses", "host": ["{{baseUrl}}"], "path": ["api", "addresses"] },
            "body": { "mode": "raw", "raw": "{\n  \"label\": \"home\",\n  \"name\": \"John\",\n  \"phone\": \"{{mobile}}\",\n  \"addressLine\": \"123 Main St, Near Bus Stand\",\n  \"city\": \"Tirupur\",\n  \"state\": \"Tamil Nadu\",\n  \"pincode\": \"641601\",\n  \"latitude\": 11.1085,\n  \"longitude\": 77.3411,\n  \"isDefault\": true\n}", "options": { "raw": { "language": "json" } } }
          }
        },
        {
          "name": "GET addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/addresses", "host": ["{{baseUrl}}"], "path": ["api", "addresses"] }
          }
        },
        {
          "name": "GET default address",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/addresses/default", "host": ["{{baseUrl}}"], "path": ["api", "addresses", "default"] }
