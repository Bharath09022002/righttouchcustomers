        {
          "name": "POST zones check-service",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}", "type": "text" }, { "key": "Content-Type", "value": "application/json", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/zones/check-service", "host": ["{{baseUrl}}"], "path": ["api", "zones", "check-service"] },
            "body": { "mode": "raw", "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"latitude\": 11.1085,\n  \"longitude\": 77.3411\n}", "options": { "raw": { "language": "json" } } }
          }
        }
      ]
    },
    {
      "name": "Stage 3 - Catalog (public)",
      "item": [
        {
          "name": "GET all categories",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/user/getAllcategory", "host": ["{{baseUrl}}"], "path": ["api", "user", "getAllcategory"] } }
        },
        {
          "name": "GET category by id",
